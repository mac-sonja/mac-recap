exports[`renderToStaticMarkup > video_9_16: the starter pages render the same markup every time (snapshot) 1`] = `
"<link rel="preload" as="image" href="https://cdn.test/lumen.svg"/><link rel="preload" as="image" href="https://cdn.test/img-1.webp"/><link rel="preload" as="image" href="https://cdn.test/img-2.webp"/><link rel="preload" as="image" href="https://cdn.test/img-3.webp"/><link rel="preload" as="image" href="https://cdn.test/img-4.webp"/><link rel="preload" as="image" href="https://cdn.test/img-5.webp"/><div class="mr-root" data-template="mac-case@1" data-format="video_9_16"><style>.mr-page{position:relative;display:block;width:100%;overflow:hidden;container-type:inline-size;box-sizing:border-box;color:#012234;font-family:Inter,sans-serif;letter-spacing:0;--gut:calc(var(--u) * 24);--bpad:calc(var(--u) * 28)}
.mr-page *,.mr-page *::before,.mr-page *::after{box-sizing:border-box}
.mr-page[data-format="presentazione_16_9"]{aspect-ratio:16/9;--u:calc(100cqw / 1920);--pad:calc(var(--u) * 64)}
.mr-page[data-format="carosello_1_1"]{aspect-ratio:1/1;--u:calc(100cqw / 1000);--pad:calc(var(--u) * 24)}
.mr-page[data-format="video_9_16"]{aspect-ratio:9/16;--u:calc(100cqw / 1080);--pad:calc(var(--u) * 24)}
.mr-page-bg{position:absolute;inset:0}
.mr-page-bg>img,.mr-page-bg>video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.mr-page-deco{position:absolute;pointer-events:none}
.mr-page-deco>svg{position:absolute;inset:0;width:100%;height:100%;display:block;overflow:visible}
.mr-bento{position:absolute;inset:var(--pad);display:grid;gap:var(--gut)}
.mr-blk{position:relative;display:flex;flex-direction:column;gap:calc(var(--u) * 12);min-width:0;min-height:0;overflow:hidden;border-radius:calc(var(--u) * 20);padding:var(--bpad);background:#EDEDF0}
.mr-blk.mr-bleed{padding:0}
.mr-bgimg{position:absolute;inset:0;z-index:0}
.mr-bgimg>img,.mr-bgimg>video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.mr-bgimg::after{content:"";position:absolute;inset:0;background:linear-gradient(to bottom,rgb(102 102 102 / 0),rgb(0 0 0 / .5))}
.mr-blk>*:not(.mr-bgimg){position:relative;z-index:1}
.mr-on-photo{color:#FFFFFF}
.mr-txt{min-width:0;max-width:100%;margin:0;overflow-wrap:break-word}
.mr-t-text{white-space:pre-line}
.mr-al-centre{text-align:center}.mr-al-right{text-align:right}
.mr-cols-2{columns:2;column-gap:calc(var(--u) * 40)}
.mr-row .mr-t-num{white-space:nowrap}
.mr-grp{display:flex;flex-direction:column;flex:1 1 auto;min-height:0;min-width:0;gap:calc(var(--u) * 12)}
.mr-grp-top{justify-content:flex-start}.mr-grp-centre{justify-content:center}.mr-grp-bottom{justify-content:flex-end}
.mr-grp-split>.mr-push{margin-bottom:auto}
.mr-row>.mr-grp{flex:1;gap:calc(var(--u) * 6)}
.mr-row{display:flex;justify-content:space-between;align-items:center;gap:calc(var(--u) * 20);min-width:0}
.mr-row.mr-wide{gap:calc(var(--u) * 110)}
.mr-row.mr-atop{align-items:flex-start}
.mr-kpirow>.mr-t-text{width:calc(var(--u) * 120);flex-shrink:0;font-weight:500;line-height:1.1}
.mr-page[data-format="video_9_16"] .mr-kpirow>.mr-t-text{width:auto;flex:1 1 0;max-width:52%;line-height:1.15}
.mr-hr{flex-shrink:0;height:1px;background:currentColor;opacity:.2;margin:calc(var(--u) * 16) 0}
.mr-hr.mr-hr-colour{opacity:1;margin:calc(var(--u) * 12) 0 calc(var(--u) * -4)}
.mr-page[data-format="carosello_1_1"] .mr-hr.mr-hr-colour{margin-top:calc(var(--u) * 28)}
.mr-page[data-format="video_9_16"] .mr-hr.mr-hr-colour{margin:calc(var(--u) * 24) 0 calc(var(--u) * 4)}
.mr-blk.mr-vinfo{gap:calc(var(--u) * 24)}
.mr-vinfo>.mr-row:first-of-type{margin-bottom:calc(var(--u) * 40)}
.mr-vinfo .mr-grp{gap:calc(var(--u) * 12)}
.mr-vinfo>.mr-t-sub{margin-top:calc(var(--u) * 4)}
.mr-vinfo>.mr-hr{margin:calc(var(--u) * 20) 0}
.mr-img{flex:1 1 0;min-height:calc(var(--u) * 40);position:relative;overflow:hidden;border-radius:calc(var(--u) * 12)}
.mr-bleed .mr-img{border-radius:0}
.mr-img>img,.mr-img>video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.mr-img[data-fit="fit"]>img,.mr-img[data-fit="fit"]>video{object-fit:contain}
.mr-tags{display:flex;flex-wrap:wrap;gap:calc(var(--u) * 6);align-content:center}
.mr-row .mr-tags{justify-content:flex-end}
.mr-tag{border-radius:999px;padding:calc(var(--u) * 7) calc(var(--u) * 14);font-weight:500;font-size:calc(var(--u) * 14);line-height:calc(var(--u) * 18.2);white-space:nowrap;background:#012234;color:#EFEFEF}
.mr-on-photo .mr-tag{background:rgb(255 255 255 / .15);color:#FFFFFF}
.mr-brand{display:flex;align-items:center;gap:calc(var(--u) * 20);flex-shrink:0}
.mr-clogo{height:calc(var(--u) * 40);width:auto;max-width:calc(var(--u) * 180);object-fit:contain;display:block}
.mr-on-photo .mr-clogo{filter:brightness(0) invert(1)}
.mr-dv{width:1px;height:calc(var(--u) * 48);display:block;background:#012234}
.mr-on-photo .mr-dv{background:#FFFFFF}
.mr-mac{width:calc(var(--u) * 89);height:calc(var(--u) * 28.914);display:block;color:#012234}
.mr-on-photo .mr-mac{color:#FFFFFF}
.mr-anim{flex:1 1 0;min-height:calc(var(--u) * 80);position:relative;overflow:hidden}
.mr-an{position:absolute;inset:0;overflow:hidden;container-type:size;transform:scale(var(--as,1));transform-origin:center}
.mr-ac{flex-shrink:0;border-radius:calc(var(--u) * 8);overflow:hidden;background:linear-gradient(135deg,#efeee9,#d6d5cf);aspect-ratio:9/16}
.mr-ac>img,.mr-ac>video{width:100%;height:100%;object-fit:cover;display:block}
.mr-anim[data-fit="fit"] .mr-ac>img,.mr-anim[data-fit="fit"] .mr-ac>video{object-fit:contain}
.mr-trk{display:flex;flex-shrink:0}
.mr-an-c01{display:flex;justify-content:center}
.mr-an-c01 .mr-trk{flex-direction:column;gap:4cqh;padding-bottom:4cqh}
.mr-an-c01 .mr-ac{height:min(68cqh,calc(60cqw * 16 / 9));width:auto}
.mr-an-c03{display:flex;flex-direction:column;align-items:center;--ch:min(76cqh,calc(54cqw * 16 / 9))}
.mr-an-c03 .mr-trk{flex-direction:column;align-items:center;gap:6cqh;margin-top:calc(50cqh - var(--ch) / 2)}
.mr-an-c03 .mr-ac{height:var(--ch);width:auto}
.mr-an-c04{display:flex;align-items:center;--cw:min(34cqw,calc(92cqh * 9 / 16))}
.mr-an-c04 .mr-trk{gap:6cqw;margin-left:calc(50cqw - var(--cw) / 2)}
.mr-an-c04 .mr-ac{width:var(--cw);height:auto}
.mr-an-w02 .mr-ring{position:absolute;inset:0}
.mr-an-w02 .mr-ac{position:absolute;left:50%;top:50%;width:16cqmin;height:auto;transform:translate(-50%,-50%) rotate(var(--a)) translateY(-31cqmin)}
.mr-page[data-format="video_9_16"] .mr-an-c04{--cw:min(58cqw,calc(84cqh * 9 / 16))}
.mr-page[data-format="video_9_16"] .mr-an-c03{--ch:min(80cqh,calc(66cqw * 16 / 9))}
.mr-page[data-format="video_9_16"] .mr-an-c01 .mr-ac{height:min(78cqh,calc(70cqw * 16 / 9))}
.mr-page[data-format="video_9_16"] .mr-an-w02 .mr-ac{width:20cqmin}
.mr-anim[data-fit="fill"] .mr-an-c04{--cw:min(70cqw,calc(100cqh * 9 / 16))}
.mr-anim[data-fit="fill"] .mr-an-c03{--ch:min(100cqh,calc(80cqw * 16 / 9))}
.mr-anim[data-fit="fill"] .mr-an-c01 .mr-ac{height:min(100cqh,calc(80cqw * 16 / 9))}
.mr-anim[data-fit="fill"] .mr-an-w02 .mr-ac{width:22cqmin}
@keyframes mr-an-y{to{transform:translateY(-50%)}}
@keyframes mr-an-spin{to{transform:rotate(360deg)}}
@keyframes mr-vtext{0%{opacity:0;transform:translateY(calc(var(--u) * 28))}14%,100%{opacity:1;transform:none}}
