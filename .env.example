# Copy to .env.local and fill in. `npx supabase status` prints the local values.
# Server-only: none of these may carry the NEXT_PUBLIC_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional basic-auth gate in front of sign-in (Story 6.2): staging sets both to
# stay private, prod and local development leave both unset or empty. Setting
# just one is an error (the web process exits 1).
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# Project files live in the private Supabase Storage bucket `material`, created
# by the migrations (`npx supabase db push`).
# Hosted Supabase caps uploads at the project's storage upload limit (50 MB on
# the Free plan), which matches MAX_FILE_BYTES.
