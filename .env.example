# Copy to .env.local and fill in. `npx supabase status` prints the local values.
# Server-only: none of these may carry the NEXT_PUBLIC_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Basic-auth gate on every request (until login ships in Epic 6). Required unless
# NODE_ENV is development or test (standalone server and `next start` use
# production): the web process exits 1 without them. Optional under `next dev`:
# the gate is on only if both are set, and setting just one is an error. Leave
# both unset or empty to develop ungated.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# Project files live in the private Supabase Storage bucket `material`, created
# by the migrations (`npx supabase db push`).
# Hosted Supabase caps uploads at the project's storage upload limit (50 MB on
# the Free plan), which matches MAX_FILE_BYTES.
