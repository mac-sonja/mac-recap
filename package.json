{
  "name": "mac-recap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:dist",
    "build:dist": "esbuild worker=src/worker/index.ts preflight=src/preflight.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist --log-level=warning",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "scripts/test-db.sh",
    "db:start": "supabase start",
    "db:types": "supabase gen types --lang=typescript --local > src/shared/db.types.ts.tmp && mv src/shared/db.types.ts.tmp src/shared/db.types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-presigned-post": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.8",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pg": "8.23.0",
    "postcss": "8.5.29",
    "shadcn": "4.21.4",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
